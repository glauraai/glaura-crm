// Glaura CRM — internal sales tool.
// Track salon leads → follow up (activities + reminders) → prepare account/demo
// → trigger onboarding engine (creates a disabled Glaura account).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────

enum Role {
  COMMERCIAL
  MANAGER
  ADMIN
}

enum Metier {
  COIFFURE
  ESTHETIQUE
  ONGLES
  BARBIER
  SPA
  AUTRE
}

enum SalonType {
  A
  B
  C
  D
}

// Pipeline stages (mockup chips: à visiter → … → signé)
enum SalonStatus {
  A_VISITER
  VISITE_FAITE
  INTERESSE
  A_RELANCER
  PAS_INTERESSE
  SIGNE
}

enum BookingTool {
  PLANITY
  TREATWELL
  ACUITY
  BOOKSY
  FRESHA
  SITE
  NONE
}

enum ActivityType {
  APPEL
  VISIO
  VISITE
  RELANCE
  EMAIL
  DEMO
  NOTE
}

enum LeadSource {
  MANUAL
  AIRTABLE
  IMPORT
  SCRAPE
}

// Prospection: salons discovered on public booking directories, not yet CRM leads.
enum ProspectSource {
  GOOGLE
  INSTAGRAM
  PLANITY
  TREATWELL
  BOOKSY
  FRESHA
  IMPORT // uploaded by a salesperson from a CSV file
}

enum ProspectStatus {
  NOUVEAU // discovered, available for a tournée
  EN_TOURNEE // picked in a daily tournée
  CONVERTI // promoted to a Salon lead
  ECARTE // manually discarded
  DEJA_CRM // matches a salon already in the CRM — excluded from tournées
}

// Instagram enrichment lifecycle (cross-validated against the salon).
enum GoogleStatus {
  A_FAIRE // not looked up yet
  TROUVE // a Google Business Profile matched this salon
  INTROUVABLE // searched, no plausible profile
  ERREUR // lookup failed for this prospect (retryable)
}

enum IgStatus {
  A_FAIRE // not enriched yet
  CONFIRME // account auto-confirmed by strong signals (booking link, name+location)
  A_VALIDER // candidates found, needs a human click
  INTROUVABLE // searched, no plausible account
  ERREUR // enrichment failed for this prospect (retryable)
}

// Onboarding engine job lifecycle (mirrors the VPS result file).
enum OnboardingStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
  ALREADY_ONBOARDED
  REVIEW_REQUIRED
}

enum EmailJobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

// ── V1 / V1.5 Sales CRM, Agents & Commissions Enums ──────────────

enum OpportunityStage {
  A_CONTACTER
  CONTACTE
  R1_PROGRAMME
  R1_EFFECTUE
  NO_SHOW
  A_RELANCER
  ANNULE
  DEVIS_ENVOYE
  ABONNE
  COMPTE_ACTIVE
  SIGNE
  ENCAISSE
  PERDU
}

enum AgentName {
  ECHO
  SCOUT
  CRAFT
  SENTINEL
  MENTOR
  GTM
}

enum SuggestionKind {
  QUALIFICATION_UPDATE
  STAGE_CHANGE
  TASK_CREATE
  QUOTE_DRAFT
  EMAIL_DRAFT
  RELANCE
  PREP_BRIEF
  PLAYBOOK_UPDATE
}

enum SuggestionStatus {
  PENDING
  APPROVED
  MODIFIED
  REJECTED
}

enum TranscriptSource {
  ALLO
  WISPR_FLOW
  UPLOAD
}

enum TranscriptMatchStatus {
  MATCHED
  UNMATCHED
  IGNORED
}

enum BillingCadence {
  MONTHLY
  ANNUAL_3X
  ANNUAL_1X
}

enum CommissionStatus {
  PREVUE
  EN_VALIDATION
  ACQUISE
  VERSEE
  PERDUE
  ARRETEE
}

enum DisputeStatus {
  OPEN
  RESOLVED_UPHELD
  RESOLVED_ADJUSTED
  REJECTED
}

// NOTE: the `EmailTemplate` enum that used to live here became a model (below) —
// templates are editable data now, not a deploy-gated code constant.

// ── Models ───────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  image           String?
  role            Role      @default(COMMERCIAL)
  active          Boolean   @default(true) // false = access revoked, including existing sessions
  createdAt       DateTime  @default(now())
  lastLogin       DateTime?
  accessGrantedAt DateTime? // explicit approval from the team administration
  bookingUrl      String? // personal demo calendar, used by the outreach /demo/<token> redirect

  tasks             SalesTask[]
  assignedProspects Prospect[]      @relation("ProspectOwner")
  prospectRuns      ProspectRun[]
  assignedSalons    Salon[]         @relation("AssignedTo")
  activities        Activity[]
  reminders         Reminder[]
  onboardingJobs    OnboardingJob[]
  emailJobs         EmailJob[]
  emailTemplates    EmailTemplate[]
  tournees          Tournee[]

  ownedOpportunities      Opportunity[]        @relation("OpportunityOwner")
  stageTransitions        StageTransition[]    @relation("StageTransitionActor")
  assignedSuggestions     AgentSuggestion[]    @relation("SuggestionAssignee")
  reviewedSuggestions     AgentSuggestion[]    @relation("SuggestionReviewer")
  transcripts             TranscriptRecord[]   @relation("TranscriptOwner")
  commissions             Commission[]         @relation("CommissionOwner")
  raisedDisputes          CommissionDispute[]  @relation("DisputeRaiser")
  resolvedDisputes        CommissionDispute[]  @relation("DisputeResolver")
  salesGoals              SalesGoal[]
  sentInstagramMessages   InstagramMessage[]   @relation("InstagramSender")
  callEvaluations         CallEvaluation[]
  objectionRecords        ObjectionRecord[]
}

model Salon {
  id                   String      @id @default(cuid())
  name                 String
  slug                 String      @unique
  metier               Metier[]    @default([]) // a salon can span several métiers
  type                 SalonType? // deal-size tier: A = biggest deal … D = smallest
  arrondissement       String?
  address              String?
  lat                  Float?
  lng                  Float?
  phone                String?
  contactName          String?
  contactEmail         String?
  instagram            String?
  bookingTool          BookingTool @default(NONE)
  bookingUrl           String?
  // Canonical host/path claimed only after /pro identity verification. Unique
  // prevents a second account from activating the same external salon page.
  bookingUrlNormalized String?     @unique
  rating               Float?
  status               SalonStatus @default(A_VISITER)
  notes                String?     @db.Text
  objection            String?     @db.Text
  priorityLabel        String?
  leadTemperature      String?
  accountStatusLabel   String?
  sourceLabel          String?

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  source            LeadSource @default(MANUAL)
  externalRef       String?    @unique // airtable record id / import key
  airtableBaseId    String?
  airtableTableId   String?
  airtableTableName String?
  airtableRecordUrl String?

  lastContactedAt     DateTime?
  nextActionAt        DateTime? // next planned touch — feeds "à relancer / priorités"
  priorityDate        DateTime? // hand-pinned "priorité du jour" — surfaces on the assignee's dashboard for that day
  signedAt            DateTime?
  activatedAt         DateTime?
  appointmentAt       DateTime?
  clientBaseImported  Boolean   @default(false)
  importedClientCount Int?

  providerId           String?   @unique // linked Firebase prod-eu userProfile UID
  siret                String?
  portfolioClaimedAt   DateTime?
  portfolioClaimedById String?
  inactivityWarnedAt   DateTime?

  // GTM 1 bis automated scoring & SCOUT prep brief
  gtmScore             Int?
  gtmPriority          String? // A | B | C | CHAINE | HORS_CIBLE | EXCLU
  gtmAngle             String?
  gtmScoreBreakdown    Json?
  gtmScoredAt          DateTime?
  prepBriefJson        Json?
  prepBriefUpdatedAt   DateTime?

  // Duplicate handling. Salons are never deleted: a duplicate is archived and
  // points at the record it was merged into, so the merge can be undone and the
  // original data stays auditable. Archived salons are hidden from the pipeline.
  archivedAt   DateTime?
  archiveNote  String?
  mergedIntoId String?
  mergedInto   Salon?    @relation("SalonMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Salon[]   @relation("SalonMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramConversations InstagramConversation[]
  tasks            SalesTask[]
  activities       Activity[]
  reminders        Reminder[]
  onboardingJobs   OnboardingJob[]
  emailJobs        EmailJob[]
  prospect         Prospect?         @relation("ProspectConversion")
  contacts         Contact[]
  opportunities    Opportunity[]
  suggestions      AgentSuggestion[]
  transcripts      TranscriptRecord[]
  subscriptions    SubscriptionLine[]
  syncedInvoices   SyncedInvoice[]
  socialSnapshots  SocialSnapshot[]
  callEvaluations  CallEvaluation[]
  objectionRecords ObjectionRecord[]

  @@index([status])
  @@index([metier])
  @@index([arrondissement])
  @@index([assignedToId])
  @@index([assignedToId, priorityDate])
  @@index([nextActionAt])
  @@index([airtableBaseId])
  @@index([archivedAt])
  @@index([gtmPriority, gtmScore])
}

// A salon discovered on a public booking directory (Planity/Treatwell/Booksy/Fresha).
// Lives outside the Salon pipeline until converted; deduped by sourceUrl.
model Prospect {
  id      String   @id @default(cuid())
  name    String
  zone    String? // zone slug from src/lib/prospection/zones.ts (derived from postalCode)
  metiers Metier[] @default([])

  address    String?
  postalCode String?
  city       String?

  source                ProspectSource
  sourceUrl             String         @unique // original discovery page
  treatwellUrl          String?        @unique
  planityUrl            String?        @unique
  dualPlatformCheckedAt DateTime? // matched on both platforms, by name and full address

  rating      Float?
  reviewCount Int    @default(0)

  instagram          String?
  instagramFollowers Int?
  igCandidates       Json? // scored candidates [{username, followers, score, signals[]}]
  igStatus           IgStatus  @default(A_FAIRE)
  igCheckedAt        DateTime?

  // Google Business Profile. Presence is a ranking signal (a findable business),
  // never a filter. googleRating/googleReviewCount stay NULL on purpose: those
  // fields would move every Places lookup to the Enterprise SKU — see the cost
  // note in lib/prospection/google-places.ts.
  googleRating      Float?
  googleReviewCount Int?
  googlePlaceId     String?
  googleName        String? // what Google matched, so a wrong match is auditable
  googleStatus      GoogleStatus @default(A_FAIRE)
  googleCheckedAt   DateTime?

  tier Int @default(1) // 1=IG inconnu … 4=IG fort (see lib/prospection/tier.ts)

  // AI fit scoring & French legal/revenue enrichment (batch-populated)
  aiScore            Float? // 0-100 Glaura fit score
  aiSpecialty        String? // both | nails | beauty | hair | barber | spa | other | unknown
  aiOwnership        String? // independent_indicated | chain_or_franchise | unknown
  aiSummary          String?   @db.Text
  aiScoredAt         DateTime?
  legalEntity        String?
  siren              String?
  siret              String?
  activeSites        Int?
  companyMatchStatus String? // VERIFIED | CANDIDATE | UNRESOLVED | EXCLUDED
  revenueEur         Int? // latest published annual company revenue (EUR)
  revenueYear        Int?
  revenueStatus      String? // PUBLISHED | CONFIDENTIAL | UNAVAILABLE
  filingUrl          String? // BODACC filing notice URL

  // Contact details a salesperson brought in a CSV import (source IMPORT).
  phone       String?
  email       String?
  website     String?
  contactName String?
  notes       String? @db.Text // mapped notes + every CSV column we could not map

  status         ProspectStatus @default(NOUVEAU)
  matchedSalonId String? // existing CRM salon this prospect was matched to (DEJA_CRM)

  salonId String? @unique // set when converted into a Salon lead
  salon   Salon?  @relation("ProspectConversion", fields: [salonId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?       @relation("ProspectOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  claimedAt    DateTime? // timestamp of rep portfolio self-claim
  tasks        SalesTask[]

  // GTM 1 bis 100-pt scoring & C-tier B2B nurture tracking
  gtmScore          Int?
  gtmPriority       String? // A | B | C | CHAINE | HORS_CIBLE | EXCLU
  gtmAngle          String?
  gtmScoreBreakdown Json?
  gtmScoredAt       DateTime?
  nurtureStep       Int       @default(0)
  nurtureNextAt     DateTime?
  nurtureStoppedAt  DateTime?
  socialSnapshots   SocialSnapshot[]

  tourneeId String?
  tournee   Tournee? @relation(fields: [tourneeId], references: [id], onDelete: SetNull)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zone, status, reviewCount])
  @@index([zone, status, tier])
  @@index([status])
  @@index([tourneeId])
  @@index([assignedToId, status])
  @@index([igStatus])
  @@index([googleStatus])
  @@index([aiScore])
  @@index([aiSpecialty])
  @@index([siren])
  @@index([gtmPriority, gtmScore])
}

// A daily prospecting round: 20-30 prospects in one zone, assigned to a commercial.
model Tournee {
  id           String     @id @default(cuid())
  date         DateTime   @db.Date
  zone         String
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  prospects    Prospect[]

  @@unique([date, zone])
}

model Activity {
  id                  String       @id @default(cuid())
  salonId             String
  salon               Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  opportunityId       String?
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contactId           String?
  contact             Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type                ActivityType
  source              String? // MANUAL | ALLO | WISPR_FLOW
  durationSec         Int?
  isDecisionMakerCall Boolean?
  transcriptId        String?
  notes               String?      @db.Text
  outcome             String?
  scheduledAt         DateTime?
  durationMin         Int?
  calendarEventId     String?
  calendarEventUrl    String?
  meetUrl             String?
  createdAt           DateTime     @default(now())

  @@index([salonId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, scheduledAt])
}

model Reminder {
  id        String    @id @default(cuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId    String? // assignee
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  dueAt     DateTime
  done      Boolean   @default(false)
  archivedAt DateTime?
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, done, dueAt])
  @@index([salonId])
}

model EmailJob {
  id            String  @id @default(cuid())
  salonId       String
  salon         Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  to          String
  from        String?
  // Snapshot of the template key at send time. Kept as a plain string so the
  // history stays readable even if the template is later renamed or archived.
  templateKey String
  templateId  String?
  template    EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject     String
  // `body` is what gets sent as the main part: plaintext for TEXT jobs, the
  // rendered markup for HTML ones. `bodyText` carries the plaintext alternative
  // of an HTML job so the message is never HTML-only.
  format      EmailFormat    @default(TEXT)
  body        String         @db.Text
  bodyText    String?        @db.Text
  status      EmailJobStatus @default(QUEUED)
  attempts    Int            @default(0)
  lastError   String?        @db.Text
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([salonId, createdAt])
}

// Plaintext sales copy vs. a full HTML email (the onboarding « Compte prêt »
// template). The format decides how src/lib/emailTemplates.ts renders a body —
// HTML never drops a line and escapes what it interpolates — and how the worker
// hands it to nodemailer.
enum EmailFormat {
  TEXT
  HTML
}

// Follow-up email templates, editable from /modeles by any signed-in user.
// Bodies use the `{{salon}}` / `{{contact}}` / `{{bookingUrl}}` placeholders
// rendered by src/lib/emailTemplates.ts, plus the onboarding placeholders
// (`{{email_salon}}`, `{{mot_de_passe}}`, …) on HTML templates.
model EmailTemplate {
  id    String @id @default(cuid())
  // Slug derived from the label on creation and never changed afterwards, so
  // renaming a template does not orphan the EmailJob rows that reference it.
  key   String @unique
  label String

  subject String
  format  EmailFormat @default(TEXT)
  body    String      @db.Text

  sortOrder  Int       @default(0)
  // Soft delete: archived templates leave the dropdown but stay joinable from
  // the jobs they produced.
  archivedAt DateTime?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  jobs EmailJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, sortOrder])
}

model OnboardingJob {
  id            String  @id @default(cuid())
  salonId       String
  salon         Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  sourceUrl  String
  sourceType String? // planity | treatwell | acuity | generic
  status     OnboardingStatus @default(QUEUED)

  // Per-job onboarding overrides (P6 full onboarding): loginEmail, loginPassword,
  // enable, deposit, agentCount, reviewTarget. Null → legacy disabled behavior.
  config Json?

  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  exitCode    Int?
  eventCount  Int       @default(0)
  lastEventAt DateTime?

  accountUid    String?
  loginEmail    String?
  loginPassword String? // engine-generated; reveal is audit-logged in UI
  serviceCount  Int?
  agentCount    Int?
  warnings      Json?
  error         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OnboardingJobEvent[]

  @@index([status])
  @@index([salonId])
  @@index([createdAt])
}

model OnboardingJobEvent {
  id    String        @id @default(cuid())
  jobId String
  job   OnboardingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sequence Int
  stream   String // stdout | stderr | system
  type     String?
  subtype  String?
  level    String?
  text     String? @db.Text
  data     Json?

  createdAt DateTime @default(now())

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
  @@index([type])
}

/// One row per (edition, salon) of the monthly feature digest; sentAt set means delivered.
model FeatureDigestSend {
  id         String    @id @default(cuid())
  edition    String
  providerId String
  email      String
  sentAt     DateTime?
  error      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([edition, providerId])
  @@index([edition])
}

// Persistent work survives daily rounds. Conversation references stay admin-only.
model SalesTask {
  requestKey              String?   @unique
  id                      String    @id @default(cuid())
  title                   String
  context                 String?   @db.Text
  dueAt                   DateTime
  doneAt                  DateTime?
  outcome                 String?   @db.Text
  assignedToId            String
  assignedTo              User      @relation(fields: [assignedToId], references: [id])
  prospectId              String?
  prospect                Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  salonId                 String?
  salon                   Salon?    @relation(fields: [salonId], references: [id], onDelete: SetNull)
  instagramMessageId      String?
  instagramConversationId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([assignedToId, doneAt, dueAt])
  @@index([prospectId])
  @@index([salonId])
}

model ProspectRun {
  id            String    @id @default(cuid())
  kind          String
  query         String?
  zone          String
  source        String?
  limit         Int       @default(50)
  status        String    @default("QUEUED")
  summary       String?   @db.Text
  requestedById String
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  heartbeatAt   DateTime?

  @@index([status, createdAt])
}

model InstagramConversation {
  id            String             @id
  participantId String
  username      String?
  salonId       String?
  salon         Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)
  waitingAt     DateTime?
  lastMessageAt DateTime
  lastInboundAt DateTime?
  resolvedAt    DateTime?
  qualification String?
  qualificationReason String?
  qualificationAction String?
  qualificationConfidence String?
  qualificationSource String?
  qualifiedMessageId String?
  qualifiedMessageHash String?
  qualifiedAt DateTime?
  qualificationPending Boolean @default(false)
  qualificationStartedAt DateTime?
  qualificationError String?
  messages      InstagramMessage[]
  outreach      OutreachSequence?

  @@index([salonId])
  @@index([lastMessageAt])
}

model InstagramMessage {
  id             String                @id
  conversationId String
  conversation   InstagramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  incoming       Boolean
  text           String                @db.Text
  sentAt         DateTime
  sentByUserId   String?
  sentByUser     User?                 @relation("InstagramSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt])
}

// Automated demo-booking follow-up for one Instagram conversation (IG → WhatsApp).
// One row per conversation, never re-created: a stopped sequence stays stopped.
model OutreachSequence {
  conversationId String                @id
  conversation   InstagramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String                @default("ACTIVE") // ACTIVE | STOPPED | DONE
  step           Int                   @default(0) // next step to run (0..3)
  nextRunAt      DateTime?
  phone          String? // E.164, only a number the contact gave in the DM
  stopReason     String?
  lastSentAt     DateTime?
  lastError      String?
  leaseAt        DateTime?
  startedById    String?
  linkToken      String                @unique @default(uuid()) // public /demo/<token> redirect
  linkClicks     Int                   @default(0)
  linkClickedAt  DateTime?
  startedAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, nextRunAt])
}

// Singleton (id "default"): editable settings of the demo-booking sequence
// (/automatisations). No row = code defaults (sequence off).
model OutreachSettings {
  id              String   @id @default("default")
  enabled         Boolean  @default(false)
  autoStart       Boolean  @default(false)
  step0Text       String   @db.Text
  step1Text       String   @db.Text
  askPhoneText    String   @db.Text
  step1DelayHours Int      @default(20)
  step2DelayDays  Int      @default(2)
  step3DelayDays  Int      @default(5)
  sendHourStart   Int      @default(9)
  sendHourEnd     Int      @default(20)
  template1       String   @default("glaura_demo_invite")
  template2       String   @default("glaura_demo_last_call")
  templateLang    String   @default("fr")
  calendarUrl     String?
  updatedById     String?
  updatedAt       DateTime @updatedAt
}

// Singleton queue and progress for the private admin inbox history import.
model InstagramSync {
  id String @id
  status String @default("QUEUED")
  stage String?
  metaConversations Int @default(0)
  metaMessages Int @default(0)
  firebaseThreads Int @default(0)
  firebaseMessages Int @default(0)
  requestedAt DateTime @default(now())
  startedAt DateTime?
  heartbeatAt DateTime?
  finishedAt DateTime?
  error String?
}

// ── V1 / V1.5 Models: Pipeline, Agents, Transcripts, Pricing & Commissions ──

model Contact {
  id              String   @id @default(cuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  role            String?
  isDecisionMaker Boolean  @default(false)
  phone           String?
  phoneNormalized String? // E.164 or canonical FR digits for Allo matching
  email           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activities  Activity[]
  transcripts TranscriptRecord[]

  @@index([salonId])
  @@index([phoneNormalized])
  @@index([email])
}

model Opportunity {
  id                String           @id @default(cuid())
  salonId           String
  salon             Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  title             String           @default("Abonnement Glaura")
  stage             OpportunityStage @default(A_CONTACTER)
  monthlyAmountEur  Float?
  nextStep          String?
  nextStepAt        DateTime?
  lossReason        String?
  atRisk            Boolean          @default(false)
  riskReason        String?
  riskFlaggedAt     DateTime?
  riskHandledStatus String? // OPEN | RELANCE_PROPOSED | RESOLVED
  ownerId           String?
  owner             User?            @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerLockedAt     DateTime? // locked when stage reaches SIGNE
  signedAt          DateTime?
  qualificationJson Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  transitions      StageTransition[]
  ownershipLogs    OwnershipAuditLog[]
  activities       Activity[]
  suggestions      AgentSuggestion[]
  transcripts      TranscriptRecord[]
  subscriptions    SubscriptionLine[]
  commission       Commission?
  callEvaluations  CallEvaluation[]
  objectionRecords ObjectionRecord[]

  @@index([salonId])
  @@index([ownerId, stage])
  @@index([stage, updatedAt])
  @@index([atRisk, stage])
}

model StageTransition {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  changedById   String?
  changedBy     User?             @relation("StageTransitionActor", fields: [changedById], references: [id], onDelete: SetNull)
  source        String            @default("MANUAL") // MANUAL | AGENT_VALIDATED | SYSTEM
  createdAt     DateTime          @default(now())

  @@index([opportunityId, createdAt])
}

model OwnershipAuditLog {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromUserId    String?
  toUserId      String?
  changedById   String
  reason        String
  createdAt     DateTime    @default(now())

  @@index([opportunityId, createdAt])
}

// Human-in-the-loop approval queue: every agent proposes here, never mutates directly.
model AgentSuggestion {
  id               String           @id @default(cuid())
  agent            AgentName
  kind             SuggestionKind
  targetType       String // SALON | OPPORTUNITY | TASK | QUOTE | PLAYBOOK
  targetId         String?
  salonId          String?
  salon            Salon?           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?            @relation("SuggestionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status           SuggestionStatus @default(PENDING)
  title            String
  proposedPayload  Json
  appliedPayload   Json? // rep-edited payload when MODIFIED (enables Fodé diff view)
  generationReport Json // { actionsTaken[], assumptions[], toVerify[], sources[] }
  reviewedById     String?
  reviewedBy       User?            @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([status, assignedToId, createdAt])
  @@index([salonId, status])
  @@index([agent, status])
}

// Call & meeting transcripts (Allo webhook, Wispr Flow, manual upload). Raw text auto-purged after 12 months.
model TranscriptRecord {
  id                  String                @id @default(cuid())
  source              TranscriptSource
  externalId          String                @unique
  salonId             String?
  salon               Salon?                @relation(fields: [salonId], references: [id], onDelete: SetNull)
  opportunityId       String?
  opportunity         Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contactId           String?
  contact             Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId              String?
  user                User?                 @relation("TranscriptOwner", fields: [userId], references: [id], onDelete: SetNull)
  callerPhone         String?
  participantEmails   String[]              @default([])
  callDirection       String? // INBOUND | OUTBOUND
  callResult          String? // ANSWERED | MISSED | VOICEMAIL
  recordingUrl        String?
  durationSec         Int?
  occurredAt          DateTime              @default(now())
  rawTranscript       String?               @db.Text
  summary             String?               @db.Text
  isDecisionMakerCall Boolean?
  matchStatus         TranscriptMatchStatus @default(UNMATCHED)
  echoProcessedAt     DateTime?
  mentorProcessedAt   DateTime?
  purgedAt            DateTime?
  createdAt           DateTime              @default(now())

  callEvaluation   CallEvaluation?
  objectionRecords ObjectionRecord[]

  @@index([matchStatus, createdAt])
  @@index([salonId, occurredAt])
  @@index([echoProcessedAt, matchStatus])
  @@index([mentorProcessedAt, matchStatus])
}

// Line-item subscription / quote configuration & Stripe checkout payment link.
model SubscriptionLine {
  id               String         @id @default(cuid())
  opportunityId    String?
  opportunity      Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  salonId          String
  salon            Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  planCode         String // essentiel_v3 | salon_solo | salon_v3 | tout_en_un_v3 | etc.
  label            String
  cadence          BillingCadence @default(MONTHLY)
  listMonthlyCents Int
  discountPercent  Float          @default(0)
  netMonthlyCents  Int
  freeMonths       Int            @default(0)
  lauraChannels    String? // instagram | whatsapp | both | phone | full
  lauraCents       Int            @default(0)
  syncIncluded     Boolean        @default(false)
  syncCents        Int            @default(0)
  checkoutUrl      String?
  status           String         @default("DRAFT") // DRAFT | SENT | ACCEPTED | PAID
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([salonId, createdAt])
  @@index([opportunityId])
}

// Quarterly immutable commission plan rules (never retroactive).
model CommissionPlanVersion {
  id                                String   @id @default(cuid())
  quarterKey                        String   @unique // e.g. "2026-Q4"
  baseRate                          Float    @default(0.7716) // 1250 / 1620
  m1TargetEur                       Float    @default(810)
  standardTargetEur                 Float    @default(1620)
  accel2Threshold                   Float    @default(1.0)
  accel2Multiplier                  Float    @default(2.0)
  accel3Threshold                   Float    @default(1.5)
  accel3Multiplier                  Float    @default(3.0)
  guaranteeEur                      Float    @default(1250)
  guaranteeMinDmCalls               Int      @default(120)
  guaranteeMinMeetings              Int      @default(40)
  minDecisionMakerCallSec           Int      @default(90)
  excludeCancelledBeforeTwoInvoices Boolean  @default(true)
  effectiveFrom                     DateTime
  effectiveTo                       DateTime
  createdAt                         DateTime @default(now())

  commissions Commission[]
}

// Read-only mirror of Stripe invoices fetched via rk_live key + Firestore prod-eu providerId.
model SyncedInvoice {
  id                   String    @id @default(cuid())
  stripeInvoiceId      String    @unique
  providerId           String
  salonId              String?
  salon                Salon?    @relation(fields: [salonId], references: [id], onDelete: SetNull)
  stripeCustomerId     String
  stripeSubscriptionId String?
  amountPaidCents      Int
  status               String // paid | open | void | uncollectible
  paidAt               DateTime?
  refunded             Boolean   @default(false)
  disputed             Boolean   @default(false)
  billingReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([providerId, paidAt])
  @@index([salonId, paidAt])
}

model Commission {
  id                String                @id @default(cuid())
  opportunityId     String                @unique
  opportunity       Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User                  @relation("CommissionOwner", fields: [ownerId], references: [id])
  planVersionId     String
  planVersion       CommissionPlanVersion @relation(fields: [planVersionId], references: [id])
  signedMonth       String // YYYY-MM
  cadence           BillingCadence        @default(MONTHLY)
  mrrSignedEur      Float
  discountPercent   Float                 @default(0)
  effectiveRate     Float
  baseAmountEur     Float
  finalAmountEur    Float
  status            CommissionStatus      @default(PREVUE)
  paidInvoicesCount Int                   @default(0)
  acquiredAt        DateTime?
  settledAt         DateTime?
  paidOutAt         DateTime?
  lossReason        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  disputes CommissionDispute[]

  @@index([ownerId, signedMonth])
  @@index([status, signedMonth])
}

model CommissionDispute {
  id             String        @id @default(cuid())
  commissionId   String
  commission     Commission    @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  raisedById     String
  raisedBy       User          @relation("DisputeRaiser", fields: [raisedById], references: [id])
  reason         String        @db.Text
  status         DisputeStatus @default(OPEN)
  resolutionNote String?       @db.Text
  resolvedById   String?
  resolvedBy     User?         @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([commissionId])
  @@index([status, createdAt])
}

model SalesGoal {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodKey      String // YYYY-MM
  targetMrrEur   Float    @default(1620)
  targetMeetings Int      @default(40)
  targetDmCalls  Int      @default(120)
  isRampMonth    Boolean  @default(false) // M1 / M2 guarantee eligibility
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, periodKey])
}

// Singleton ("default") tracking inbound "Être appelé" round-robin rotation.
model RoundRobinState {
  id             String   @id @default("default")
  lastAssignedId String?
  updatedAt      DateTime @updatedAt
}

// ── Phase 3 & 4 Models: Social Snapshots, MENTOR Call Scoring, Objections & Automation Config ──

model SocialSnapshot {
  id              String    @id @default(cuid())
  salonId         String?
  salon           Salon?    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  prospectId      String?
  prospect        Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  monthKey        String // YYYY-MM
  igFollowers     Int?
  igPosts         Int?
  igAvgReelViews  Int?
  tiktokFollowers Int?
  googleReviews   Int?
  googleRating    Float?
  capturedAt      DateTime  @default(now())

  @@unique([salonId, monthKey])
  @@unique([prospectId, monthKey])
  @@index([monthKey])
}

model CallEvaluation {
  id             String           @id @default(cuid())
  transcriptId   String           @unique
  transcript     TranscriptRecord @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  salonId        String?
  salon          Salon?           @relation(fields: [salonId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  overallScore   Int // 0..100
  stepScoresJson Json // 8-step Fodé rubric breakdown
  strengths      String[]         @default([])
  improvements   String[]         @default([])
  closingLevers  String[]         @default([])
  salesAngleUsed String?
  createdAt      DateTime         @default(now())

  @@index([salonId, createdAt])
  @@index([userId, createdAt])
  @@index([opportunityId])
}

model ObjectionRecord {
  id            String            @id @default(cuid())
  transcriptId  String?
  transcript    TranscriptRecord? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  salonId       String?
  salon         Salon?            @relation(fields: [salonId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  category      String
  verbatim      String            @db.Text
  responseGiven String?           @db.Text
  succeeded     Boolean?
  createdAt     DateTime          @default(now())

  @@index([category, createdAt])
  @@index([salonId, createdAt])
  @@index([opportunityId])
}

// Singleton ("default") for CRM-wide GTM / agent automation toggles.
model CrmAutomationConfig {
  id                    String   @id @default("default")
  cTierNurtureEnabled   Boolean  @default(false) // OFF by default until B2B legal copy validated
  decemberPauseEnabled  Boolean  @default(true)
  inactivityWarningDays Int      @default(75)
  inactivityReleaseDays Int      @default(90)
  updatedById           String?
  updatedAt             DateTime @updatedAt
}
